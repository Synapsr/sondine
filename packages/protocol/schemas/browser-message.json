{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sondine:browser:1:browser-message",
  "$comment": "Generated from packages/protocol/src by `pnpm --filter @sondine/protocol run gen`. Do not edit.",
  "title": "Sondine browser extension message",
  "description": "One native message from Sondine's browser extension, one JSON line on core's browser socket.",
  "$ref": "#/$defs/BrowserMessage",
  "$defs": {
    "BrowserMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hello"
            },
            "extension": {
              "$ref": "#/$defs/VersionText"
            },
            "refreshMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 600000
            }
          },
          "required": ["type", "extension"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tabs"
            },
            "at": {
              "$ref": "#/$defs/UnixMs"
            },
            "tabs": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/AudibleTab"
              }
            },
            "read": {
              "type": "object",
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": ["start", "event", "refresh"]
                },
                "tabs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "audible": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "pages": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": ["cause", "tabs", "audible"],
              "additionalProperties": false
            }
          },
          "required": ["type", "at", "tabs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "media"
            },
            "at": {
              "$ref": "#/$defs/UnixMs"
            },
            "tab": {
              "$ref": "#/$defs/TabId"
            },
            "videoId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "positionMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "ad": {
              "type": "boolean"
            }
          },
          "required": ["type", "at", "tab", "videoId", "positionMs", "durationMs", "rate", "ad"],
          "additionalProperties": false
        }
      ],
      "description": "One message from the extension to core."
    },
    "VersionText": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "description": "Version or build string."
    },
    "UnixMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix time in milliseconds (Date.now())."
    },
    "AudibleTab": {
      "type": "object",
      "properties": {
        "tab": {
          "$ref": "#/$defs/TabId"
        },
        "url": {
          "$ref": "#/$defs/PageUrl"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": ["tab", "url", "title"],
      "additionalProperties": false,
      "description": "A tab that plays sound, outside private windows."
    },
    "TabId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "The browser's tab id."
    },
    "PageUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?:\\/\\/[^\\s]+$",
      "description": "An http or https address, at most 2048 characters."
    }
  }
}
