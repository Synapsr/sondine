<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the __TEXT,__info_plist section of sondine-audio (Package.swift).
     App Sandbox refuses to start a helper whose signature carries no bundle
     identifier (ADR 010). The usage strings match the app's (electron-builder.yml);
     check-package.mjs compares them. The version matches SondineAudioCommand.version. -->
<plist version="1.0">
  <dict>
    <key>CFBundleIdentifier</key>
    <string>app.sondine.audio</string>
    <key>CFBundleName</key>
    <string>sondine-audio</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>27.0</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Sondine listens to your microphone to keep a private memory of your conversations. The audio stays on this Mac unless you choose to send it elsewhere.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Sondine records the audio your apps play, such as calls and videos, to keep a private memory of them. The audio stays on this Mac unless you choose to send it elsewhere.</string>
  </dict>
</plist>
