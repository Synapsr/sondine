{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "electron-vite/node"],
    "lib": ["es2024", "dom"],
    // Paraglide's compiled messages (used by the tray) and the build scripts are JavaScript.
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/main",
    "src/preload",
    "src/core",
    "src/shared",
    "test",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.build.config.ts"
  ]
}
