# Sondine desktop — variables lues par `pnpm release:mac` (scripts/build-mac.mjs).
# Les valeurs vivent dans Infisical, projet `sondine-next`, dossier /desktop
# (dev et prod identiques) : `pnpm release:mac` les charge avec `infisical run`.
# L'app elle-même ne lit aucune variable d'environnement.

# ─── Notarisation (clé API App Store Connect de l'équipe P5G8WAJ2G2) ───
# Identifiant de la clé (10 caractères).
APPLE_API_KEY_ID=
# Issuer ID de l'équipe (UUID).
APPLE_API_ISSUER=
# Le fichier AuthKey_<id>.p8, encodé en base64 sur une ligne.
APPLE_API_KEY_P8=
