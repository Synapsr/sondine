<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sondine-browser (Contents/Helpers), the native messaging host browsers
     start for Sondine's extension (ADR 023). App Sandbox with no network
     entitlement: it reaches core's socket in the group container, its own
     stdio, and nothing else. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
      <string>P5G8WAJ2G2.app.sondine</string>
    </array>
  </dict>
</plist>
