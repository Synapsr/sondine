{
  "name": "@sondine/desktop",
  "version": "0.10.0",
  "private": true,
  "description": "Sondine desktop app: Electron shell, core utility process, and renderer.",
  "license": "AGPL-3.0-only",
  "author": "Téo Goulois",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/compile-messages.mjs && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:fake": "node scripts/compile-messages.mjs && env -u ELECTRON_RUN_AS_NODE SONDINE_FAKE_HELPER=1 electron-vite dev",
    "dev:fake-hal": "node scripts/compile-messages.mjs && env -u ELECTRON_RUN_AS_NODE SONDINE_HELPER_HAL=fake electron-vite dev",
    "dev:notch": "node scripts/dev-notch.mjs",
    "build": "node scripts/compile-messages.mjs && electron-vite build",
    "build:mac": "node scripts/build-mac.mjs",
    "release:mac": "SONDINE_STATS_ENDPOINT=https://stats.sondine.app/v1/report infisical run --path /desktop -- node scripts/build-mac.mjs --release",
    "check:package": "node scripts/check-package.mjs",
    "messages": "node scripts/compile-messages.mjs",
    "icons:tray": "node scripts/generate-tray-icons.mjs",
    "ux:shots": "node scripts/ux/shots.ts",
    "ux:header": "node scripts/ux/header-geometry.ts",
    "typecheck": "node scripts/compile-messages.mjs && tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "node scripts/compile-messages.mjs && vitest run && vitest run --config vitest.build.config.ts",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@effect/vitest": "catalog:",
    "@electron/fuses": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "4.5.6",
    "@modelcontextprotocol/server": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@sondine/api": "workspace:*",
    "@sondine/core": "workspace:*",
    "@sondine/db": "workspace:*",
    "@sondine/engines": "workspace:*",
    "@sondine/protocol": "workspace:*",
    "@sondine/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "linkedom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "smol-toml": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "productName": "Sondine"
}
