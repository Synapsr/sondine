    },
    "The Mac cannot take this recording. It stays on the iPhone: share it to keep it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac cannot take this recording. It stays on the iPhone: share it to keep it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac ne peut pas prendre cet enregistrement. Il reste sur l’iPhone : partagez-le pour le garder."
          }
        }
      }
    },
    "The Mac did not answer. Check that the iPhone is on the same Wi-Fi as the Mac and that Sondine may use the local network (Settings ▸ Sondine).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not answer. Check that the iPhone is on the same Wi-Fi as the Mac and that Sondine may use the local network (Settings ▸ Sondine)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n’a pas répondu. Vérifiez que l’iPhone est sur le même Wi-Fi que le Mac et que Sondine a accès au réseau local (Réglages ▸ Sondine)."
          }
        }
      }
    },
    "The Mac did not answer. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac did not answer. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n’a pas répondu. Réessayez."
          }
        }
      }
    },
    "The Mac has no room left for the next recording. It stays on the iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac has no room left for the next recording. It stays on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac n’a plus de place pour le prochain enregistrement. Il reste sur l’iPhone."
          }
        }
      }
    },
    "The Mac holds another recording under this one's id. This one stays on the iPhone: share it to keep it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac holds another recording under this one's id. This one stays on the iPhone: share it to keep it."
