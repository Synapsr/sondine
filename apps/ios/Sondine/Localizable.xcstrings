    },
    "The recording of %@ stopped abruptly: the app was closed, or the battery ran out. It is kept up to its last seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording of %@ stopped abruptly: the app was closed, or the battery ran out. It is kept up to its last seconds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement de %@ s’est arrêté brusquement : l’app a été fermée, ou la batterie s’est vidée. Il est gardé jusqu’à ses dernières secondes."
          }
        }
      }
    },
    "The rest of this conversation is too long for the iPhone: read it on the Mac.": {
      "localizations": {
