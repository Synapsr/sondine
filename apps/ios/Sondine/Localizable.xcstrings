    "Live Activities are off for Sondine: without one, iOS does not let it record from the Lock Screen. Turn them on in Settings, or open Sondine to record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are off for Sondine: without one, iOS does not let it record from the Lock Screen. Turn them on in Settings, or open Sondine to record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées pour Sondine : sans elles, iOS ne le laisse pas enregistrer depuis l’écran verrouillé. Activez-les dans Réglages, ou ouvrez Sondine pour enregistrer."
          }
        }
      }
    },
