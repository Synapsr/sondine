          }
        }
      }
    },
    "The iPhone stops syncing with it and erases its access, the results it fetched, and the deletions, names and notes not yet sent. Recordings not sent stay on the iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone stops syncing with it and erases its access, the results it fetched, and the deletions, names and notes not yet sent. Recordings not sent stay on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone cesse de se synchroniser avec lui et efface son accès, les résultats récupérés, et les suppressions, noms et notes pas encore envoyés. Les enregistrements non envoyés restent sur l’iPhone."
          }
        }
      }
    },
    "The journal of this day is not written yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal of this day is not written yet."
