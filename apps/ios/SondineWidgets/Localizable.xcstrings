    },
    "Sondine could not be reached. Open it to record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondine could not be reached. Open it to record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondine ne répond pas. Ouvrez l’app pour enregistrer."
          }
        }
      }
    },
    "Sondine no longer answers. Open it to see whether it records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondine no longer answers. Open it to see whether it records."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondine ne répond plus. Ouvrez l’app pour voir s’il enregistre encore."
          }
        }
      }
    },
    "Starts or stops a recording with Sondine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts or stops a recording with Sondine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance ou arrête un enregistrement avec Sondine."
          }
        }
      }
    },
    "Starts or stops a recording. If iOS does not let it start from the Lock Screen, Sondine opens to start it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts or stops a recording. If iOS does not let it start from the Lock Screen, Sondine opens to start it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance ou arrête un enregistrement. Si iOS ne le laisse pas démarrer depuis l’écran verrouillé, Sondine s’ouvre pour le lancer."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "fr": {
