<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only the group shared with the app: the control reads its state there (ADR 031). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.sondine.ios.shared</string>
	</array>
</dict>
</plist>
